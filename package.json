{
  "name": "superpowers",
  "version": "7.0.1",
  "description": "Superpowers skills and runtime bootstrap for coding agents",
  "type": "module",
  "main": ".opencode/plugins/superpowers.js",
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./.dsh/cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0"
    }
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/superpowers.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
